{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/booking", "destination": "/api/booking.js" },
    { "source": "/api/availability", "destination": "/api/availability.js" },
    { "source": "/api/diary", "destination": "/api/diary.js" },
    { "source": "/api/attendance", "destination": "/api/attendance.js" },
    { "source": "/api/walkin", "destination": "/api/walkin.js" },
    { "source": "/api/admin", "destination": "/api/admin.js" },
    { "source": "/api/refresh-series", "destination": "/api/refresh-series.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
